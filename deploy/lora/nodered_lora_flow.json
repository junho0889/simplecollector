    {
        "id": "mqtt_in_lora",
        "type": "mqtt in",
        "z": "lora_flow_tab",
        "name": "MQTT plc/data",
        "topic": "plc/data",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_rpi",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 200,
        "wires": [["parse_tags"]]
    },
    {
        "id": "parse_tags",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "태그별 분리",
        "func": "// tag_id → 이름/단위 매핑\nconst TAG_MAP = {\n    1:  { name: 'temperature',    unit: '℃',    key: 'v_float' },\n    2:  { name: 'humidity',        unit: '%',     key: 'v_float' },\n    3:  { name: 'pressure',        unit: 'hPa',   key: 'v_float' },\n    4:  { name: 'battery',         unit: '%',     key: 'v_int' },\n    5:  { name: 'version',         unit: '',      key: 'v_int' },\n    6:  { name: 'mode',            unit: '',      key: 'v_int' },\n    7:  { name: 'accel_rms_x',     unit: 'g',     key: 'v_float' },\n    8:  { name: 'accel_rms_y',     unit: 'g',     key: 'v_float' },\n    9:  { name: 'accel_rms_z',     unit: 'g',     key: 'v_float' },\n    10: { name: 'velocity_rms',    unit: 'mm/s',  key: 'v_float' },\n    11: { name: 'accel_rms_1k5k',  unit: 'g',     key: 'v_float' },\n    12: { name: 'vibration_peak',  unit: '',      key: 'v_int' },\n    13: { name: 'harmony_cnt_low', unit: '',      key: 'v_int' },\n    14: { name: 'harmony_cnt_high',unit: '',      key: 'v_int' },\n    15: { name: 'gravity_mag',     unit: '',      key: 'v_int' },\n    16: { name: 'sound_db',        unit: 'dB',    key: 'v_int' },\n    17: { name: 'sound_peak',      unit: '',      key: 'v_int' },\n    18: { name: 'prob_temp',       unit: '℃',    key: 'v_float' },\n    19: { name: 'rssi',            unit: 'dBm',   key: 'v_int' },\n    20: { name: 'snr',             unit: 'dB',    key: 'v_float' }\n};\n\nconst data = msg.payload.data;\nif (!data) return null;\n\n// 전체 요약 (output 0)\nlet summary = {};\nfor (const item of data) {\n    const tag = TAG_MAP[item.tag_id];\n    if (tag) {\n        summary[tag.name] = item[tag.key] + (tag.unit ? ' ' + tag.unit : '');\n    }\n}\n\n// 개별 태그 출력 (output 1~5: 환경, 진동, 소음, 무선, 시스템)\nlet env = {}, vib = {}, snd = {}, rf = {}, sys = {};\n\nfor (const item of data) {\n    const tag = TAG_MAP[item.tag_id];\n    if (!tag) continue;\n    const val = item[tag.key];\n    const label = tag.name + (tag.unit ? ' (' + tag.unit + ')' : '');\n\n    if ([1,2,3,18].includes(item.tag_id)) {\n        env[label] = val;\n    } else if ([7,8,9,10,11,12].includes(item.tag_id)) {\n        vib[label] = val;\n    } else if ([13,14,15,16,17].includes(item.tag_id)) {\n        snd[label] = val;\n    } else if ([19,20].includes(item.tag_id)) {\n        rf[label] = val;\n    } else {\n        sys[label] = val;\n    }\n}\n\nreturn [\n    { payload: summary, topic: 'summary' },\n    { payload: env,     topic: 'environment' },\n    { payload: vib,     topic: 'vibration' },\n    { payload: snd,     topic: 'sound' },\n    { payload: rf,      topic: 'rf_signal' },\n    { payload: sys,     topic: 'system' }\n];",
        "outputs": 6,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 200,
        "wires": [
            ["debug_summary"],
            ["debug_env", "gauge_temp", "gauge_humidity", "gauge_pressure"],
            ["debug_vib", "gauge_accel_x", "gauge_vel"],
            ["debug_snd", "gauge_sound"],
            ["debug_rf", "gauge_rssi", "gauge_snr"],
            ["debug_sys"]
        ],
        "outputLabels": ["전체 요약", "환경", "진동", "소음", "RF신호", "시스템"]
    },
