    {
        "id": "extract_env",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "환경값 추출",
        "func": "const d = msg.payload;\nconst key = Object.keys(d)[0] || '';\nif (key.startsWith('temperature')) msg.payload = d[key];\nelse if (key.startsWith('humidity')) msg.payload = d[key];\nelse if (key.startsWith('pressure')) msg.payload = d[key];\nreturn msg;",
        "outputs": 1,
        "x": 570,
        "y": 620,
        "wires": []
    },
    {
        "id": "splitter_env",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "환경 분배",
        "func": "const d = msg.payload;\nlet temp = null, hum = null, pres = null, probe = null;\n\nfor (const [k, v] of Object.entries(d)) {\n    if (k.startsWith('temperature')) temp = v;\n    else if (k.startsWith('humidity')) hum = v;\n    else if (k.startsWith('pressure')) pres = v;\n    else if (k.startsWith('prob_temp')) probe = v;\n}\n\nreturn [\n    temp !== null ? { payload: temp } : null,\n    hum !== null ? { payload: hum } : null,\n    pres !== null ? { payload: pres } : null\n];",
        "outputs": 3,
        "x": 560,
        "y": 700,
        "wires": [["gauge_temp"], ["gauge_humidity"], ["gauge_pressure"]],
        "outputLabels": ["온도", "습도", "기압"]
    },
    {
        "id": "splitter_vib",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "진동 분배",
        "func": "const d = msg.payload;\nlet ax = null, vel = null;\n\nfor (const [k, v] of Object.entries(d)) {\n    if (k.startsWith('accel_rms_x')) ax = v;\n    else if (k.startsWith('velocity')) vel = v;\n}\n\nreturn [\n    ax !== null ? { payload: ax } : null,\n    vel !== null ? { payload: vel } : null\n];",
        "outputs": 2,
        "x": 560,
        "y": 760,
        "wires": [["gauge_accel_x"], ["gauge_vel"]],
        "outputLabels": ["가속도X", "속도"]
    },
    {
        "id": "splitter_snd",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "소음 분배",
        "func": "const d = msg.payload;\nlet db = null;\nfor (const [k, v] of Object.entries(d)) {\n    if (k.startsWith('sound_db')) db = v;\n}\nreturn db !== null ? { payload: db } : null;",
        "outputs": 1,
        "x": 560,
        "y": 820,
        "wires": [["gauge_sound"]]
    },
    {
        "id": "splitter_rf",
        "type": "function",
        "z": "lora_flow_tab",
        "name": "RF 분배",
        "func": "const d = msg.payload;\nlet rssi = null, snr = null;\nfor (const [k, v] of Object.entries(d)) {\n    if (k.startsWith('rssi')) rssi = v;\n    else if (k.startsWith('snr')) snr = v;\n}\nreturn [\n    rssi !== null ? { payload: rssi } : null,\n    snr !== null ? { payload: snr } : null\n];",
        "outputs": 2,
        "x": 560,
        "y": 880,
        "wires": [["gauge_rssi"], ["gauge_snr"]],
        "outputLabels": ["RSSI", "SNR"]
    },
    {
        "id": "comment_usage",
        "type": "comment",
        "z": "lora_flow_tab",
        "name": "사용법",
        "info": "## LoRa Sensor Monitor\n\n### MQTT 브로커\n- Host: 192.168.1.2 (RPi)\n- Port: 1883\n- Topic: plc/data\n\n### 데이터 구조\n5초마다 20개 태그 수신:\n- 환경: 온도, 습도, 기압, 프로브온도\n- 진동: 가속도 XYZ, 속도RMS, 피크\n- 소음: dB, 피크, 고조파\n- RF: RSSI, SNR\n- 시스템: 배터리, 버전, 모드\n\n### Dashboard\nnode-red-dashboard 설치 필요:\n```\nnpm install node-red-dashboard\n```\n→ http://localhost:1880/ui",
        "x": 130,
        "y": 60,
        "wires": []
    }
]
