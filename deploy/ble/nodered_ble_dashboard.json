    {
        "id": "ble_mqtt_in",
        "type": "mqtt in",
        "z": "ble_dash_tab",
        "name": "BLE Data",
        "topic": "#",
        "qos": "0",
        "datatype": "json",
        "broker": "ble_mqtt_broker",
        "x": 110,
        "y": 100,
        "wires": [["ble_parse_fn"]]
    },
    {
        "id": "ble_parse_fn",
        "type": "function",
        "z": "ble_dash_tab",
        "name": "Parse & Route",
        "func": "var data = msg.payload.data;\nif (!data || data.length === 0) return [null, null, null];\n\nvar firstTag = data[0].tag_id;\nvar sensor = 0;\nif (firstTag >= 1 && firstTag <= 19) sensor = 1;\nelse if (firstTag >= 21 && firstTag <= 39) sensor = 2;\nelse if (firstTag >= 41 && firstTag <= 54) sensor = 3;\nelse return [null, null, null];\n\nvar vals = {};\nfor (var i = 0; i < data.length; i++) {\n    var t = data[i];\n    var v = (t.v_float !== undefined && t.v_float !== null) ? t.v_float : t.v_int;\n    if (v === undefined || v === null) continue;\n    vals[t.tag_id] = v;\n}\n\nvar out = {payload: vals, sensor: sensor};\nvar msgs = [null, null, null];\nmsgs[sensor - 1] = out;\nreturn msgs;",
        "outputs": 3,
        "x": 310,
        "y": 100,
        "wires": [["ble_fmt_1","ble_g_t1","ble_g_h1","ble_g_b1"], ["ble_fmt_2","ble_g_t2","ble_g_h2","ble_g_b2"], ["ble_fmt_3","ble_g_t3","ble_g_h3","ble_g_b3"]]
    },
    {
        "id": "ble_fmt_1",
        "type": "function",
        "z": "ble_dash_tab",
        "name": "Format 1호기",
        "func": "var v = msg.payload;\nvar lines = [];\nvar f = function(id,name,dec) {\n    if (v[id] !== undefined) {\n        var val = (dec !== undefined) ? Number(v[id]).toFixed(dec) : v[id];\n        lines.push(name + ': ' + val);\n    }\n};\nf(1,'온도',2); f(2,'습도',2); f(3,'기압',2); f(4,'배터리'); f(5,'프로브온도',2);\nf(6,'가속도X',3); f(7,'가속도Y',3); f(8,'가속도Z',3);\nf(9,'속도RMS',3); f(10,'가속도1-5k',3);\nf(11,'진동피크'); f(12,'고조파<1k'); f(13,'고조파1-5k');\nf(14,'중력크기'); f(15,'소음dB'); f(16,'소음피크');\nf(17,'RSSI'); f(18,'버전'); f(19,'모드');\nmsg.payload = lines.join('\\n');\nreturn msg;",
        "outputs": 1,
        "x": 550,
        "y": 40,
        "wires": [["ble_txt_1"]]
    },
    {
        "id": "ble_fmt_2",
        "type": "function",
        "z": "ble_dash_tab",
        "name": "Format 2호기",
        "func": "var v = msg.payload;\nvar lines = [];\nvar f = function(id,name,dec) {\n    if (v[id] !== undefined) {\n        var val = (dec !== undefined) ? Number(v[id]).toFixed(dec) : v[id];\n        lines.push(name + ': ' + val);\n    }\n};\nf(21,'온도',2); f(22,'습도',2); f(23,'기압',2); f(24,'배터리'); f(25,'프로브온도',2);\nf(26,'가속도X',3); f(27,'가속도Y',3); f(28,'가속도Z',3);\nf(29,'속도RMS',3); f(30,'가속도1-5k',3);\nf(31,'진동피크'); f(32,'고조파<1k'); f(33,'고조파1-5k');\nf(34,'중력크기'); f(35,'소음dB'); f(36,'소음피크');\nf(37,'RSSI'); f(38,'버전'); f(39,'모드');\nmsg.payload = lines.join('\\n');\nreturn msg;",
        "outputs": 1,
        "x": 550,
        "y": 100,
        "wires": [["ble_txt_2"]]
    },
    {
        "id": "ble_fmt_3",
        "type": "function",
        "z": "ble_dash_tab",
        "name": "Format 3호기",
        "func": "var v = msg.payload;\nvar lines = [];\nvar f = function(id,name,dec) {\n    if (v[id] !== undefined) {\n        var val = (dec !== undefined) ? Number(v[id]).toFixed(dec) : v[id];\n        lines.push(name + ': ' + val);\n    }\n};\nf(41,'온도',2); f(42,'습도',2); f(43,'소음dB'); f(44,'속도RMS');\nf(45,'가속도X'); f(46,'가속도Y'); f(47,'가속도Z');\nf(48,'진동FFT Hz'); f(49,'소음FFT Hz'); f(50,'프로브',2);\nf(51,'배터리'); f(52,'RSSI'); f(53,'버전'); f(54,'모드');\nmsg.payload = lines.join('\\n');\nreturn msg;",
