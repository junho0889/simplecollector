[
    {
        "id": "ble_debug_flow",
        "type": "tab",
        "label": "BLE Debug",
        "disabled": false,
        "info": "BLE 센서 MQTT 데이터 디버깅"
    },
    {
        "id": "mqtt_broker_ble",
        "type": "mqtt-broker",
        "name": "BLE Mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "nodered-ble-debug",
        "autoConnect": true,
        "usetls": false,
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "closeTopic": "",
        "willTopic": "",
        "sessionExpiry": ""
    },
    {
        "id": "mqtt_sub_all",
        "type": "mqtt in",
        "z": "ble_debug_flow",
        "name": "BLE ALL (ble/#)",
        "topic": "ble/#",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_ble",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 120,
        "y": 80,
        "wires": [["parse_ble", "debug_raw"]]
    },
    {
        "id": "debug_raw",
        "type": "debug",
        "z": "ble_debug_flow",
        "name": "Raw Message",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 340,
        "y": 40,
        "wires": []
    },
    {
        "id": "parse_ble",
        "type": "function",
        "z": "ble_debug_flow",
        "name": "Parse BLE Data",
        "func": "// topic: ble/{plc_id}/{group}\nconst parts = msg.topic.split('/');\nconst plcId = parts[1];\nconst group = parts[2];\nconst records = msg.payload;\n\n// tag_id → tag_name 매핑\nconst TAG_MAP = {\n    1: 'temperature', 2: 'humidity', 3: 'pressure',\n    4: 'battery', 5: 'prob_temp',\n    6: 'accel_rms_x', 7: 'accel_rms_y', 8: 'accel_rms_z',\n    9: 'velocity_rms', 10: 'accel_1k5k',\n    11: 'vib_peak', 12: 'harmony_low', 13: 'harmony_high',\n    14: 'gravity_mag', 15: 'sound_db', 16: 'sound_peak',\n    17: 'rssi', 18: 'version', 19: 'mode',\n    20: 'battery_low'\n};\n\n// 레코드를 {tag_name: value} 형태로 변환\nconst parsed = {};\nrecords.forEach(r => {\n    const name = TAG_MAP[r.tag_id] || `tag_${r.tag_id}`;\n    const val = r.v_float ?? r.v_int ?? r.v_bool ?? r.v_text ?? null;\n    parsed[name] = val;\n});\n\nmsg.payload = {\n    plc_id: plcId,\n    group: group,\n    source_time: records[0]?.source_time,\n    tag_count: records.length,\n    data: parsed\n};\nmsg.topic = `${plcId}/${group}`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 80,
        "wires": [["debug_parsed", "switch_group"]]
    },
    {
        "id": "debug_parsed",
        "type": "debug",
        "z": "ble_debug_flow",
        "name": "Parsed Data",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload.group + ' | ' + payload.tag_count + ' tags'",
        "statusType": "jsonata",
        "x": 550,
        "y": 40,
        "wires": []
    },
    {
        "id": "switch_group",
        "type": "switch",
        "z": "ble_debug_flow",
        "name": "Group Split",
        "property": "payload.group",
        "propertyType": "msg",
        "rules": [
            {"t": "eq", "v": "ble_env", "vt": "str"},
            {"t": "eq", "v": "ble_vib", "vt": "str"},
            {"t": "eq", "v": "ble_alm", "vt": "str"}
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 3,
        "x": 540,
        "y": 120,
        "wires": [["gauge_temp", "gauge_humi", "gauge_press"], ["gauge_accel"], ["debug_alarm"]]
    },
    {
        "id": "gauge_temp",
        "type": "function",
        "z": "ble_debug_flow",
        "name": "Temperature",
        "func": "msg.payload = msg.payload.data.temperature;\nmsg.topic = 'temperature';\nreturn msg;",
        "outputs": 1,
        "x": 730,
        "y": 80,
        "wires": [["debug_env"]]
    },
    {
        "id": "gauge_humi",
        "type": "function",
        "z": "ble_debug_flow",
        "name": "Humidity",
        "func": "msg.payload = msg.payload.data.humidity;\nmsg.topic = 'humidity';\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 120,
        "wires": [["debug_env"]]
    },
    {
        "id": "gauge_press",
        "type": "function",
        "z": "ble_debug_flow",
        "name": "Pressure",
        "func": "msg.payload = msg.payload.data.pressure;\nmsg.topic = 'pressure';\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 160,
        "wires": [["debug_env"]]
    },
    {
        "id": "debug_env",
        "type": "debug",
        "z": "ble_debug_flow",
        "name": "ENV Values",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "true",
        "targetType": "full",
        "statusVal": "topic & ': ' & $string(payload)",
        "statusType": "jsonata",
        "x": 910,
        "y": 120,
        "wires": []
    },
    {
        "id": "gauge_accel",
        "type": "function",
        "z": "ble_debug_flow",
        "name": "Vibration Summary",
        "func": "const d = msg.payload.data;\nmsg.payload = {\n    accel_x: d.accel_rms_x,\n    accel_y: d.accel_rms_y,\n    accel_z: d.accel_rms_z,\n    velocity: d.velocity_rms,\n    peak: d.vib_peak,\n    sound_db: d.sound_db\n};\nmsg.topic = 'vibration';\nreturn msg;",
        "outputs": 1,
        "x": 750,
        "y": 220,
        "wires": [["debug_vib"]]
    },
    {
        "id": "debug_vib",
        "type": "debug",
        "z": "ble_debug_flow",
        "name": "VIB Values",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "'X:' & $string(payload.accel_x) & ' Y:' & $string(payload.accel_y) & ' Z:' & $string(payload.accel_z)",
        "statusType": "jsonata",
        "x": 920,
        "y": 220,
        "wires": []
    },
    {
        "id": "debug_alarm",
        "type": "debug",
        "z": "ble_debug_flow",
        "name": "ALARM",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "'battery_low: ' & $string(payload.data.battery_low)",
        "statusType": "jsonata",
        "x": 710,
        "y": 280,
        "wires": []
    }
]
