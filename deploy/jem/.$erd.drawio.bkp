<!-- GROUP NOTE -->
<mxCell id="n1" value="&lt;b&gt;그룹 인스턴스 (Group Instances)&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:10px;line-height:18px;&quot;&gt;&lt;b&gt;plc_data&lt;/b&gt; — 실시간 데이터 (polling 1-2s)&lt;br/&gt;&amp;nbsp;&amp;nbsp;master, latest, integrated&lt;br/&gt;&lt;br/&gt;&lt;b&gt;alm&lt;/b&gt; — 알람 (on_change)&lt;br/&gt;&amp;nbsp;&amp;nbsp;master, latest, integrated&lt;br/&gt;&amp;nbsp;&amp;nbsp;+ history (값 변경 이력, trigger_on: v_bool)&lt;br/&gt;&amp;nbsp;&amp;nbsp;+ snapshot (신호 캡처, rising edge)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;action&lt;/b&gt; — 액션 (on_change)&lt;br/&gt;&amp;nbsp;&amp;nbsp;master, latest&lt;br/&gt;&lt;br/&gt;&lt;b&gt;log&lt;/b&gt; — 설비 로그 (polling 5s)&lt;br/&gt;&amp;nbsp;&amp;nbsp;master, latest, integrated&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;하이퍼테이블 (Hypertable)&lt;/b&gt;: 1일 청크&lt;br/&gt;&lt;b&gt;압축 (Compression)&lt;/b&gt;: 7일 후&lt;br/&gt;&lt;b&gt;보관 (Retention)&lt;/b&gt;: 설정 가능&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="930" width="280" height="400" as="geometry"/></mxCell>

