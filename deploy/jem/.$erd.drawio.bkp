<!-- ===== LEGEND ===== -->
<mxCell id="leg" value="&lt;b&gt;범례 (Legend)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;table style=&quot;font-size:10px;line-height:22px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e1d5e7;width:16px;height:14px;border:1px solid #9673a6;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;설정 테이블 (Config)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#f5f5f5;border:1px solid #666;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;이력 테이블 (History)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;퍼블리셔 전역 (Publisher Global)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#d5e8d4;border:1px solid #82b366;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;퍼블리셔 그룹 (Publisher Group)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#fff2cc;border:1px solid #d6b656;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;퍼블리셔 확장 (Extension)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;border:1px solid #b85450;&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;생산 테이블 (Production)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;font-size:10px;line-height:16px;&quot;&gt;&lt;b&gt;테이블 구조 (Table Structure)&lt;/b&gt;&lt;br/&gt;구분선 위 = 기본키 (PK) 영역&lt;br/&gt;구분선 아래 = 일반 컬럼 영역&lt;br/&gt;&lt;b&gt;(FK)&lt;/b&gt; = PK이면서 FK인 컬럼&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; 접두사 = 외래키 (Foreign Key)&lt;br/&gt;&lt;b&gt;NOT NULL&lt;/b&gt; = 필수 컬럼&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IE 표기법 (IE Notation)&lt;/b&gt;&lt;br/&gt;실선 = FK 관계 (FK Relationship)&lt;br/&gt;점선 = 트리거/데이터흐름 (Trigger)&lt;br/&gt;&lt;br/&gt;|&lt;b&gt;|&lt;/b&gt;&amp;mdash; 정확히 하나 (Exactly One)&lt;br/&gt;&lt;b&gt;O&lt;/b&gt;&amp;mdash; 0 또는 하나 (Zero or One)&lt;br/&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&amp;lt; 다수 (Many, Crow&amp;apos;s Foot)&lt;br/&gt;&lt;b&gt;O&amp;gt;&lt;/b&gt;&amp;lt; 0 이상 (Zero or Many)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#999;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1050" y="50" width="260" height="380" as="geometry"/></mxCell>

